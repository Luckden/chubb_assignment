{
  // MCP servers for VS Code (Copilot agent mode). Claude Code uses /.mcp.json.
  // https://angular.dev/ai/mcp · https://daisyui.com/docs/mcp/
  "servers": {
    "angular-cli": {
      "command": "npx",
      "args": ["-y", "@angular/cli@21", "mcp"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "daisyui": {
      "type": "http",
      "url": "https://gitmcp.io/saadeghi/daisyui"
    }
  }
}
