  "components": {
    "schemas": {
      "ClaimResponse": {
        "required": [
          "id",
          "claimNumber",
          "claimantId",
          "assigneeId",
          "type",
          "status",
          "incidentDate",
          "description",
          "claimedAmount",
          "decisionOutcome",
          "decisionReason",
          "decidedAt",
          "submittedAt",
          "statusHistory",
          "informationRequests"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "claimNumber": {
            "type": "string"
          },
          "claimantId": {
            "type": "string",
            "format": "uuid"
          },
          "assigneeId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "type": {
            "$ref": "#/components/schemas/ClaimType"
          },
          "status": {
            "$ref": "#/components/schemas/ClaimStatus"
          },
          "incidentDate": {
            "type": "string",
            "format": "date"
          },
          "description": {
            "type": "string"
          },
          "claimedAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "decisionOutcome": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/DecisionOutcome"
              }
            ]
          },
          "decisionReason": {
            "type": [
              "null",
              "string"
            ]
          },
          "decidedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time"
          },
          "statusHistory": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClaimStatusChangeResponse"
            }
          },
          "informationRequests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InformationRequestResponse"
            }
          }
        },
        "description": "R2: a claim with its history and information requests, so the claimant can track it."
      },
      "ClaimStatus": {
        "enum": [
          "Submitted",
          "UnderReview",
          "InfoRequested",
          "Settled",
          "Rejected"
        ],
        "description": "Lifecycle of a claim. Allowed transitions are documented in docs/design/04-claim-lifecycle.md."
      },
      "ClaimStatusChangeResponse": {
        "required": [
          "fromStatus",
          "toStatus",
          "changedBy",
          "changedAt",
